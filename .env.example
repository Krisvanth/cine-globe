# ==============================================================================
# CineGlobe Environment Configuration
# ==============================================================================
# Copy this file to .env.local for local development.
# Do not commit real production secrets into source control.

# ------------------------------------------------------------------------------
# Supabase Authentication & PostgreSQL Database
# ------------------------------------------------------------------------------
# Get these from your Supabase project settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Privileged service role key (only for secure administrative server tasks)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ------------------------------------------------------------------------------
# Google OAuth Credentials (configured in Supabase Auth -> Providers -> Google)
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ------------------------------------------------------------------------------
# The Movie Database (TMDB) API
# ------------------------------------------------------------------------------
# Used for live worldwide movie discovery and Watch Providers (JustWatch data).
# If omitted or pending, CineGlobe automatically runs in verified offline catalogue mode.
TMDB_API_KEY=your-tmdb-v3-api-key-here

# ------------------------------------------------------------------------------
# Licensed Regional Streaming Availability Provider (Optional)
# ------------------------------------------------------------------------------
STREAMING_API_BASE_URL=https://api.themoviedb.org/3
STREAMING_API_KEY=your-streaming-api-key-here
